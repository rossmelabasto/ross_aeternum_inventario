# Cadena de conexión a Supabase por el pooler de sesión (IPv4), con el rol propio de la API.
# Supabase → Project Settings → Database → Connection string → Session pooler
DATABASE_URL=postgresql+psycopg://aeternum_api.TU_PROJECT_REF:TU_PASSWORD@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,https://aeternum-3d.rossmel.com
# Clave para operaciones de borrado (cabecera X-Admin-Key)
ADMIN_KEY=cambia-esto
